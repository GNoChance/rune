+  opacity: 0.45;
+}
+
+@media (hover: hover) {
+  .choiceCard:has(.overlayInput:hover:not(:disabled, :checked)) {
+    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
+  }
+
+  .chip:has(.overlayInput:hover:not(:disabled, :checked)) {
+    border-color: var(--accent);
+  }
+}
+
+/* Petit ressort de la coche à l'apparition (220 ms) ; sous mouvement réduit, un simple fondu. */
+.checkGlyph {
+  animation: check-pop 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+
+@keyframes check-pop {
+  from {
+    opacity: 0;
+    transform: scale(0.4);
+  }
+
+  60% {
+    opacity: 1;
+    transform: scale(1.18);
+  }
+
+  to {
+    transform: scale(1);
+  }
+}
+
+@keyframes check-fade {
+  from {
+    opacity: 0;
+  }
+}
+
+/* Coche de la pastille choisie, en pastillon sur son coin : elle ne prend pas de place au libellé. */
+.chipCheck {
+  position: absolute;
+  top: -6px;
+  right: -4px;
+  display: grid;
+  place-items: center;
+  width: 20px;
+  height: 20px;
+  border-radius: 50%;
+  background: var(--accent-text);
+  color: var(--accent);
+  box-shadow: 0 0 0 2px var(--accent);
+}
+
+.chipCheck svg {
+  width: 12px;
+  height: 12px;
+}
+
+/* Interrupteur (maquettes Profil et Salle) : piste 50 × 30 dans une cible de 52 × 44. */
+.switchRow {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 14px;
+  min-height: 44px;
+}
+
+.switchText {
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+}
+
+.switchLabel {
   font-weight: 600;
+  line-height: 1.3;
+  cursor: pointer;
+}
+
+.switch {
+  flex: none;
+  display: grid;
+  place-items: center;
+  min-width: 52px;
+  min-height: 44px;
+  padding: 0;
+  border: 0;
+  border-radius: 999px;
+  background: transparent;
+  cursor: pointer;
+}
+
+.switchTrack {
+  display: flex;
+  align-items: center;
+  width: 50px;
+  height: 30px;
+  padding: 3px;
+  border-radius: 999px;
+  background: var(--field-border);
+  transition: background-color 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+
+.switchThumb {
+  width: 24px;
+  height: 24px;
+  border-radius: 50%;
+  background: var(--text-muted);
+  transition:
+    transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1),
+    background-color 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+
+.switch[aria-checked="true"] .switchTrack {
+  background: var(--accent);
+}
+
+.switch[aria-checked="true"] .switchThumb {
+  transform: translateX(20px);
+  background: var(--accent-text);
+}
+
+/* Progression de l'onboarding : segments de 6 px, dégradé d'accent étalé sur toute la barre. */
+.progress {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+}
+
+.segments {
+  flex: 1;
+  display: grid;
+  grid-auto-columns: minmax(0, 1fr);
+  grid-auto-flow: column;
+  gap: var(--space-1);
+}
+
+.segment {
+  height: 6px;
+  border-radius: 3px;
+  background-color: color-mix(in srgb, var(--text-muted) 18%, var(--surface));
+}
+
+/* Chaque segment fait montre sa tranche du dégradé, comme si la barre entière en était peinte. */
+.segment[data-done] {
+  background-image: linear-gradient(90deg, var(--accent), var(--accent-2));
+  background-size: calc(var(--segment-last) * 100% + 100%) 100%;
+  background-position: calc(var(--segment-index) / var(--segment-last) * 100%) 0;
+  transition: background-color 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+
+.progressText {
+  margin: 0;
+  font-size: 0.8125rem;
+  color: var(--text-muted);
+  white-space: nowrap;
+}
+
+/* Badges (GUIDE, Badges) : rôle en contour accent, statut en teinte avec un point. */
+.badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  min-height: 24px;
+  padding: 0 9px;
+  border-radius: 999px;
+  font-size: 0.78125rem;
+  font-weight: 600;
+  line-height: 1.2;
+  white-space: nowrap;
+}
+
+.badgeDot {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: currentColor;
+}
+
+.badgeAccent {
+  border: 1px solid var(--accent);
+  color: var(--accent);
+}
+
+/* Vert assombri vers le texte : 4,5:1 sur sa teinte dans chaque thème (le vert seul n'y suffit pas en clair). */
+.badgeSuccess {
+  background: color-mix(in srgb, var(--success) 12%, var(--surface));
+  color: color-mix(in srgb, var(--success) 70%, var(--text));
+}
+
+.badgeMuted {
+  background: color-mix(in srgb, var(--text-muted) 12%, var(--surface));
+  color: var(--text-muted);
+}
+
+.badgeWarning {
+  background: var(--warning-bg);
+  color: var(--warning-text);
+}
+
+.badgeDanger {
+  background: color-mix(in srgb, var(--danger) 12%, var(--surface));
+  color: var(--danger);
+}
+
+/* Listes (GUIDE, List row) : lignes de 56 px regroupées dans une carte, séparées d'un trait. */
+.listSection {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2);
+}
+
+.listTitle {
+  margin: 0 0 0 var(--space-1);
+  font-family: var(--font-display);
+  font-size: 0.75rem;
+  font-weight: 600;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
+  color: var(--text-muted);
+}
+
+.listGroup {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  border-radius: var(--radius-card);
+  overflow: hidden;
+  background: var(--surface);
+  border: 1px solid var(--border);
+}
+
+.listItem + .listItem {
+  border-top: 1px solid var(--border);
+}
+
+.row {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  width: 100%;
+  min-height: 56px;
+  margin: 0;
+  padding: var(--space-2) 14px var(--space-2) var(--space-3);
+  border: 0;
+  background: transparent;
+  color: var(--text);
+  font: inherit;
+  text-align: start;
+  text-decoration: none;
+}
+
+a.row,
+button.row {
+  cursor: pointer;
+  transition: background-color 150ms cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+
+a.row:focus-visible,
+button.row:focus-visible {
+  outline-offset: -2px;
+}
+
+@media (hover: hover) {
+  a.row:hover,
+  button.row:hover {
+    background: color-mix(in srgb, var(--accent) 6%, var(--surface));
+  }
+}
+
+.rowIcon {
+  flex: none;
+  display: grid;
+  place-items: center;
+  width: 36px;
+  height: 36px;
+  border-radius: 11px;
+  background: color-mix(in srgb, var(--accent) 10%, var(--surface));
+  color: var(--accent);
+}
+
+.rowIcon svg {
+  width: 20px;
+  height: 20px;
+}
+
+.rowText {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 1px;
+}
+
+.rowLabel {
+  font-weight: 600;
+  line-height: 1.25;
+}
+
+.rowValue {
+  overflow: hidden;
+  font-size: 0.8125rem;
+  line-height: 1.3;
+  color: var(--text-muted);
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.rowBadge {
+  flex: none;
+  display: flex;
+}
+
+.rowChevron {
+  flex: none;
+  color: var(--text-muted);
+}
+
+.row[data-tone="danger"] {
+  color: var(--danger);
+}
+
+.row[data-tone="danger"] .rowIcon {
+  background: color-mix(in srgb, var(--danger) 12%, var(--surface));
+  color: var(--danger);
+}
+
+/* État vide (GUIDE, Empty state) : icône de 48 px dans un cercle teinté d'accent, titre, phrase, action. */
+.empty {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: var(--space-2);
+  padding: var(--space-6) var(--space-4);
+  text-align: center;
+}
+
+.emptyIcon {
+  display: grid;
+  place-items: center;
+  width: 80px;
+  height: 80px;
   margin-bottom: var(--space-2);
+  border-radius: 50%;
+  background: color-mix(in srgb, var(--accent) 12%, var(--bg));
+  color: var(--accent);
+}
+
+.emptyIcon svg {
+  width: 48px;
+  height: 48px;
 }
 
-.choice {
+.emptyTitle {
+  margin: 0;
+  font-family: var(--font-title);
+  font-size: 1.0625rem;
+  font-weight: 700;
+}
+
+.emptyText {
+  margin: 0;
+  max-width: 32ch;
+  color: var(--text-muted);
+}
+
+.emptyAction {
+  width: 100%;
+  margin-top: var(--space-2);
+}
+
+/* En-tête de page interne (GUIDE, Inner page header) : Retour 44 × 44, titre 24/700. */
+.pageHeader {
   display: flex;
   align-items: center;
   gap: var(--space-3);
-  min-height: 44px;
-  padding: var(--space-2) var(--space-3);
-  border: 1px solid var(--field-border);
+}
+
+.backButton {
+  flex: none;
+  display: grid;
+  place-items: center;
+  width: 44px;
+  height: 44px;
+  padding: 0;
   border-radius: var(--radius-control);
+  border: 1px solid var(--border);
   background: var(--surface);
+  color: var(--text);
+  cursor: pointer;
+}
+
+.pageTitle {
+  margin: 0;
+  min-width: 0;
+  font-size: 1.5rem;
+  font-weight: 700;
+  line-height: 1.2;
 }
 
 .healthWarning {
   font-size: 0.875rem;
   color: var(--text-muted);
 }
+
+/* Mouvement réduit (spec refonte §7) : ni déplacement ni ressort, des fondus simples. */
+@media (prefers-reduced-motion: reduce) {
+  .button,
+  .switchThumb {
+    transition-property: background-color;
+  }
+
+  .button:active:not(:disabled) {
+    transform: none;
+  }
+
+  .checkGlyph {
+    animation-name: check-fade;
+  }
+}
