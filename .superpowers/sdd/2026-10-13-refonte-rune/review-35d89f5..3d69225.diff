+
+  it('ligne du jour du Scribe sans rythme connu : la ligne suivante, jamais « {jours} » ni une valeur inventée', () => {
+    expect(coachLine('scribe', 'daily', new Date('2026-10-16T10:00:00Z'), 'lea', null)).toBe(
