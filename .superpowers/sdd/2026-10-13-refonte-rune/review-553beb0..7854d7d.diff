+        title="Se déconnecter"
+        onClose={() => {
+          p.onClose?.();
+          setOpen(false);
+        }}
+      >
+        <button type="button">Cet appareil</button>
+        <button type="button">Tous mes appareils</button>
+      </BottomSheet>
