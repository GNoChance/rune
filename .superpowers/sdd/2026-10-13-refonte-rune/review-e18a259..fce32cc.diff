diff --git a/apps/web/src/features/onboarding/onboarding.module.css b/apps/web/src/features/onboarding/onboarding.module.css
index 9517bdb..a1e4d1c 100644
--- a/apps/web/src/features/onboarding/onboarding.module.css
+++ b/apps/web/src/features/onboarding/onboarding.module.css
@@ -1,64 +1,421 @@
+/*
+ * Onboarding Rune (spec refonte §10.1) : mise en page des maquettes B01–B08 (titre de 28 px, phrase secondaire,
+ * cartes de choix, pastilles, cartes, barre « Retour » / « Continuer ») et célébration « Éveil terminé » du
+ * prototype. Couleurs prises dans les jetons (5 thèmes) ; mouvement sur la courbe unique et les durées communes
+ * (motion.css), remplacé par des fondus courts sans retard sous mouvement réduit. Une animation ne fait que
+ * rejouer l'arrivée (fill-mode backwards) : sans elle, tout est là, entier et visible.
+ */
+
+/* ---------- Colonne et écran ---------- */
+
+.flow {
+  width: 100%;
+  max-width: 36rem;
+  margin-inline: auto;
+}
+
+/* « Prise en main » reste le titre de la page pour les lecteurs d'écran ; à l'écran, l'étape seule (maquettes). */
+.flow h1 {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  margin: -1px;
+  padding: 0;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+  border: 0;
+}
+
+/* Marque de 22 px, puis la barre segmentée et « Étape n sur 9 » (maquettes) ; en clair, cadre à l'accent. */
+.progressRow {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  --rune-mark-frame: var(--accent);
+}
+
+.progressRow > svg {
+  flex: none;
+}
+
+.progressRow > :last-child {
+  flex: 1;
+  min-width: 0;
+}
+
 .step,
 .panel {
   display: flex;
   flex-direction: column;
   gap: var(--space-4);
 }
 
+/* Titre de l'écran (maquettes : 28 px, police des titres). */
 .step h2 {
   margin: 0;
-  font-size: 1.25rem;
+  font-size: 1.75rem;
+  font-weight: 700;
+  line-height: 1.15;
 }
 
-.panel h3 {
-  margin: 0;
-  font-size: 1.125rem;
+/* La phrase sous le titre (15,5 px, secondaire), à 6 px du titre comme dans les maquettes. */
+.lead {
+  margin: calc(6px - var(--space-4)) 0 2px;
+  font-size: 0.96875rem;
+  line-height: 1.45;
+  color: var(--text-muted);
 }
 
-.panel p {
-  margin: 0;
+/* Écran d'une seule question : sa légende sert de phrase sous le titre (maquettes B01, B02, B03, B05). */
+.question {
+  margin-top: calc(6px - var(--space-4));
 }
 
-.actions {
+.question legend {
+  margin-bottom: 18px;
+  font-size: 0.96875rem;
+  font-weight: 400;
+  line-height: 1.45;
+  color: var(--text-muted);
+}
+
+/* Liste longue (« Quel sport ? », maquette B02) : chaque pastille à la largeur de son libellé. */
+.sportList {
+  margin-top: var(--space-2);
+}
+
+.sportList fieldset > div > label {
+  flex: 0 1 auto;
+  padding-inline: 16px;
+}
+
+/* Les autres questions de l'écran (« Quel sport ? », « Séances par semaine ») : 24 px au-dessus. */
+.step > fieldset {
+  margin-top: var(--space-2);
+}
+
+/* Boutons d'une carte (accord, questionnaire, limitations) : ils se partagent la ligne, puis passent dessous. */
+.panelActions {
   display: flex;
   flex-wrap: wrap;
-  justify-content: flex-end;
   gap: var(--space-2);
 }
 
+.panelActions > * {
+  flex: 1 1 auto;
+}
+
+/* Rembourrage resserré : « Passer » et « J'accepte et je renseigne » tiennent sur une ligne à 390 px (maquette B07). */
+.panelActions > button {
+  padding-inline: 12px;
+}
+
+/* Les cartes et pastilles d'une question entrent en cascade (spec refonte §7). */
+.question fieldset > div > * {
+  animation: rise var(--dur-screen) var(--ease) backwards;
+}
+
+.question fieldset > div > :nth-child(2) {
+  animation-delay: 60ms;
+}
+
+.question fieldset > div > :nth-child(3) {
+  animation-delay: 120ms;
+}
+
+.question fieldset > div > :nth-child(4) {
+  animation-delay: 180ms;
+}
+
+.question fieldset > div > :nth-child(n + 5) {
+  animation-delay: 240ms;
+}
+
+/* Barre d'actions : l'erreur de l'écran, puis les boutons. */
+.bar {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+  margin-top: var(--space-2);
+}
+
+/*
+ * Dans l'onboarding, la barre reste en bas de l'écran (maquettes B01–B08, prototype), erreur comprise : le fond
+ * s'y fond depuis le haut de la barre, et le bas laisse la place de la zone de geste de l'iPhone.
+ */
+.flow .bar {
+  position: sticky;
+  bottom: 0;
+  z-index: 1;
+  margin-top: calc(-1 * var(--space-2));
+  padding-block: var(--space-4) calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
+  background: linear-gradient(180deg, transparent 0, var(--bg) var(--space-4));
+}
+
+/* Un champ qui prend le focus défile au-dessus de la barre (sa hauteur et la zone de geste), jamais dessous. */
+:global(html):has(.flow) {
+  scroll-padding-bottom: calc(6.5rem + env(safe-area-inset-bottom, 0px));
+}
+
+/* Boutons (maquettes) : « Retour » de 118 px à gauche, le bouton principal prend le reste ; seul, tout. */
+.actions {
+  display: flex;
+  gap: var(--space-3);
+}
+
+.back {
+  flex: 0 0 118px;
+}
+
+.primary {
+  flex: 1 1 auto;
+}
+
+.panel > button {
+  align-self: flex-start;
+}
+
+.panel p {
+  margin: 0;
+}
+
+.panel h3 {
+  margin: 0;
+  font-size: 1.0625rem;
+  font-weight: 700;
+  line-height: 1.25;
+}
+
 .note {
   margin: 0;
   font-size: 0.875rem;
-  color: var(--color-muted);
+  color: var(--text-muted);
 }
 
-.check {
+/* Note précédée d'un petit i (maquette B03). */
+.infoNote {
+  margin: 0;
   display: flex;
   align-items: flex-start;
+  gap: var(--space-2);
+  font-size: 0.875rem;
+  line-height: 1.4;
+  color: var(--text-muted);
+}
+
+.infoNote svg {
+  flex: none;
+  width: 18px;
+  height: 18px;
+  margin-top: 1px;
+}
+
+/* ---------- Cartes ---------- */
+
+.card {
+  display: flex;
+  flex-direction: column;
   gap: var(--space-3);
+  padding: 14px 16px 16px;
+  border-radius: var(--radius-card);
+  border: 1px solid var(--border);
+  background: var(--surface);
+}
+
+.card .panel > p {
+  font-size: 0.875rem;
+  line-height: 1.45;
+  color: var(--text-muted);
+}
+
+.cardHead {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+  color: var(--accent);
+}
+
+.cardHead h3 {
+  margin: 0;
+  font-size: 1.0625rem;
+  font-weight: 700;
+  line-height: 1.25;
+  color: var(--text);
+}
+
+/* Case de l'accord santé (maquette B07) : une carte, au bord accent et teintée une fois cochée. */
+.check {
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
   min-height: 44px;
+  padding: 10px 12px 10px 10px;
+  border-radius: var(--radius-control);
+  border: 1.5px solid var(--border);
+  font-size: 0.875rem;
+  line-height: 1.45;
+  cursor: pointer;
+  transition:
+    border-color var(--dur-fast) var(--ease),
+    background-color var(--dur-fast) var(--ease);
+}
+
+.check:has(input:checked) {
+  border-color: var(--accent);
+  background: color-mix(in srgb, var(--accent) 10%, var(--surface));
 }
 
 .check input {
   flex-shrink: 0;
   width: 1.5rem;
   height: 1.5rem;
