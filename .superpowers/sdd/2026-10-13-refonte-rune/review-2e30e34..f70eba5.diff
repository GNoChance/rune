@@ -0,0 +1,39 @@
+import { Link, useLocation } from 'wouter';
+import { RuneMark, RuneWordmark } from './Logo';
+import styles from './shell.module.css';
+import { activeTab, TAB_ICONS, TAB_ITEMS } from './TabBar';
+import { useColorScheme } from './use-color-scheme';
+
+/**
+ * Navigation latérale sur PC (largeur ≥ 900 px, spec refonte §5) : la marque, puis les mêmes entrées que la
+ * barre d'onglets, l'entrée active portant `aria-current="page"`.
+ */
+export function SideNav() {
+  const [path] = useLocation();
+  const active = activeTab(path);
+  const dark = useColorScheme() === 'dark';
+  return (
+    <div className={styles.sideNav} data-testid="side-nav">
+      <Link href="/" className={styles.brand} aria-label="Rune">
+        <RuneMark glow={dark} />
+        <RuneWordmark />
+      </Link>
+      <nav aria-label="Navigation principale">
+        <ul className={styles.sideList}>
+          {TAB_ITEMS.map((t) => (
+            <li key={t.href}>
+              <Link
+                href={t.href}
+                aria-current={t.href === active ? 'page' : undefined}
+                className={styles.sideItem}
+              >
+                {TAB_ICONS[t.href]}
+                {t.label}
+              </Link>
+            </li>
+          ))}
+        </ul>
+      </nav>
+    </div>
+  );
+}
diff --git a/apps/web/src/ui/TabBar.tsx b/apps/web/src/ui/TabBar.tsx
new file mode 100644
index 0000000..5c093b4
--- /dev/null
+++ b/apps/web/src/ui/TabBar.tsx
@@ -0,0 +1,110 @@
+import type { CSSProperties, ReactNode } from 'react';
+import { Link, useLocation } from 'wouter';
+import styles from './shell.module.css';
+
+export type TabHref = '/' | '/progression' | '/places' | '/profile';
+
+/** Onglets du socle (spec refonte §5) ; à la brique 5, Nutrition prend la place de Salles. */
+export const TAB_ITEMS: readonly { href: TabHref; label: string }[] = [
+  { href: '/', label: 'Accueil' },
+  { href: '/progression', label: 'Progression' },
+  { href: '/places', label: 'Salles' },
+  { href: '/profile', label: 'Profil' },
+];
+
+/** Préfixes rangés sous chaque onglet : les salles sous Salles, les réglages et l'administration sous Profil. */
+const SECTIONS: readonly { tab: TabHref; prefixes: readonly string[] }[] = [
+  { tab: '/progression', prefixes: ['/progression'] },
+  { tab: '/places', prefixes: ['/places', '/gyms'] },
+  { tab: '/profile', prefixes: ['/profile', '/settings', '/rejections', '/admin'] },
+];
+
+/**
+ * Onglet d'une adresse, par préfixe de chemin (sans tenir compte de la casse ni de la barre finale, comme
+ * les routes) : « Accueil » sur `/` exactement, `null` hors des onglets (page inconnue).
+ */
+export function activeTab(path: string): TabHref | null {
+  const p = path.toLowerCase().replace(/\/+$/, '') || '/';
+  if (p === '/') return '/';
+  for (const { tab, prefixes } of SECTIONS) {
+    if (prefixes.some((prefix) => p === prefix || p.startsWith(`${prefix}/`))) return tab;
+  }
+  return null;
+}
+
+function Icon(p: { children: ReactNode }) {
+  return (
+    <svg
+      aria-hidden="true"
+      width="23"
+      height="23"
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="1.9"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+    >
+      {p.children}
+    </svg>
+  );
+}
+
+/** Icônes des onglets (maquettes MixSombre / MixClair). */
+export const TAB_ICONS: Record<TabHref, ReactNode> = {
+  '/': (
+    <Icon>
+      <path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" />
+    </Icon>
+  ),
+  '/progression': (
+    <Icon>
+      <path d="M3 17l6-6 4 4 8-8" />
+      <path d="M14 7h7v7" />
+    </Icon>
+  ),
+  '/places': (
+    <Icon>
+      <path d="M6 7v10M3 9v6M18 7v10M21 9v6M6 12h12" />
+    </Icon>
+  ),
+  '/profile': (
+    <Icon>
+      <circle cx="12" cy="8" r="4" />
+      <path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" />
+    </Icon>
+  ),
+};
+
+/**
+ * Barre d'onglets flottante en pilule, sur téléphone (maquettes MixSombre / MixClair) : l'onglet actif porte
+ * `aria-current="page"` et la pastille glisse jusqu'à lui ; sans onglet actif, elle se cache.
+ */
+export function TabBar() {
+  const [path] = useLocation();
+  const active = activeTab(path);
+  const index = TAB_ITEMS.findIndex((t) => t.href === active);
+  return (
+    <nav aria-label="Navigation principale" data-testid="tab-bar" className={styles.tabBar}>
+      <span
+        aria-hidden="true"
+        data-tab-pill=""
+        data-index={index < 0 ? undefined : String(index)}
+        hidden={index < 0}
+        className={styles.tabPill}
+        style={{ '--tab-index': Math.max(index, 0) } as CSSProperties}
+      />
+      {TAB_ITEMS.map((t) => (
+        <Link
+          key={t.href}
+          href={t.href}
+          aria-current={t.href === active ? 'page' : undefined}
+          className={styles.tab}
+        >
+          {TAB_ICONS[t.href]}
+          {t.label}
+        </Link>
+      ))}
+    </nav>
+  );
+}
diff --git a/apps/web/src/ui/screen-transition.ts b/apps/web/src/ui/screen-transition.ts
new file mode 100644
index 0000000..a828491
--- /dev/null
+++ b/apps/web/src/ui/screen-transition.ts
@@ -0,0 +1,85 @@
+import { type RefObject, useLayoutEffect, useState } from 'react';
+import { activeTab } from './TabBar';
+import { useReducedMotion } from './use-reduced-motion';
+
+/** Entrée d'un écran (spec refonte §7) : vers l'avant depuis la droite, retour depuis la gauche, onglet en fondu. */
+export type ScreenTransition = 'forward' | 'back' | 'tab' | 'none';
+
+const clean = (path: string) => path.toLowerCase().replace(/\/+$/, '') || '/';
+
+/**
+ * Transition de `from` vers `to`, d'après la pile des écrans visités dans l'onglet (`stack`, `from` en dernier) :
+ * autre onglet → fondu ; écran parent, ou écran juste avant dans la pile (retour du navigateur) → retour ;
+ * sinon → avant.
+ */
+export function screenTransition(from: string, to: string, stack: readonly string[]): ScreenTransition {
+  const a = clean(from);
+  const b = clean(to);
+  if (a === b) return 'none';
+  if (activeTab(a) !== activeTab(b)) return 'tab';
+  if (a.startsWith(`${b}/`)) return 'back';
+  const before = stack.at(-2);
+  if (before !== undefined && clean(before) === b) return 'back';
+  return 'forward';
+}
+
+/** Pile après la transition : un onglet repart de son écran, un retour dépile, un écran nouveau s'empile. */
+function nextStack(stack: readonly string[], to: string, transition: ScreenTransition): string[] {
+  if (transition === 'tab') return [to];
+  if (transition === 'back') {
+    const before = stack.at(-2);
+    return before !== undefined && clean(before) === clean(to)
+      ? stack.slice(0, -1)
+      : [...stack.slice(0, -1), to];
+  }
+  return transition === 'none' ? [...stack] : [...stack, to];
+}
+
+interface NavState {
+  path: string;
+  stack: string[];
+  transition: ScreenTransition;
+}
+
+/** Transition de l'écran affiché, recalculée à chaque changement d'adresse du routeur (wouter). */
+export function useScreenTransition(path: string): ScreenTransition {
+  const [nav, setNav] = useState<NavState>({ path, stack: [path], transition: 'none' });
+  if (nav.path === path) return nav.transition;
+  const transition = screenTransition(nav.path, path, nav.stack);
+  // État dérivé de l'adresse : posé pendant le rendu, React rend aussitôt de nouveau avec lui.
+  setNav({ path, stack: nextStack(nav.stack, path, transition), transition });
+  return transition;
+}
+
+const EASE = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
+const SLIDE = '48px';
+
+/**
+ * Joue l'entrée de l'écran `ref` à chaque changement de `path` (Web Animations : aucun style en ligne, rien
+ * de figé à la fin). Sous mouvement réduit, un simple fondu ; sans `animate` (navigateur ancien), rien.
+ */
+export function useScreenEntrance(
+  ref: RefObject<HTMLElement | null>,
+  path: string,
+  transition: ScreenTransition,
+) {
+  const reduced = useReducedMotion();
+  // biome-ignore lint/correctness/useExhaustiveDependencies: l'entrée se rejoue à chaque nouvelle adresse.
+  useLayoutEffect(() => {
+    const el = ref.current;
+    if (!el || transition === 'none' || typeof el.animate !== 'function') return;
+    const fade = { opacity: [0, 1] };
+    const keyframes =
+      reduced || transition === 'tab'
+        ? fade
+        : {
+            ...fade,
+            transform: [`translateX(${transition === 'forward' ? SLIDE : `-${SLIDE}`})`, 'none'],
+          };
+    const duration = reduced ? 200 : transition === 'tab' ? 300 : 380;
+    const animation = el.animate(keyframes, { duration, easing: EASE });
+    // Annulée par l'écran suivant : sa promesse `finished` rejetée n'est pas une erreur.
+    animation.finished?.catch(() => {});
+    return () => animation.cancel();
+  }, [path]);
+}
diff --git a/apps/web/src/ui/shell.module.css b/apps/web/src/ui/shell.module.css
new file mode 100644
index 0000000..eec1b0e
--- /dev/null
+++ b/apps/web/src/ui/shell.module.css
@@ -0,0 +1,339 @@
+/*
+ * Coquille des écrans connectés (spec refonte §5, maquettes MixSombre / MixClair) : en-tête de l'accueil,
+ * pastille de connexion, barre d'onglets flottante (téléphone), navigation latérale (≥ 900 px), voile du
+ * démarrage. Couleurs : jetons de theme/tokens.css seulement, donc juste dans les 5 thèmes.
+ */
+
+/* Téléphone : la page garde sous elle la place de la barre flottante (68 px, 16 px au-dessus et en dessous). */
+.shell {
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+  overflow-x: clip;
+  padding-bottom: calc(100px + env(safe-area-inset-bottom, 0px));
+}
+
+.column {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+}
+
+.main {
+  flex: 1;
+  width: 100%;
+  max-width: var(--content-width);
+  margin: 0 auto;
+  padding: 18px;
+  padding-inline-start: max(18px, var(--page-inset-start));
+}
+
+/* En-tête de l'accueil : marque à gauche, pastille et initiale à droite. */
+.header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-3);
+  width: 100%;
+  max-width: var(--content-width);
+  margin: 0 auto;
+  padding: 18px 18px 0;
+  padding-inline-start: max(18px, var(--page-inset-start));
+}
+
+/* Logo et mot RUNE : en clair, cadre du logo à l'accent et rune à l'encre (GUIDE). */
+.brand {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  min-height: 44px;
+  color: var(--text);
+  font-size: 1.0625rem;
+  text-decoration: none;
+  --rune-mark-frame: var(--accent);
+}
+
+.headerEnd {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  min-width: 0;
+}
+
+/* Rond de 36 px de l'initiale, dans une cible de 44 × 44. */
+.avatar {
+  flex: none;
+  display: grid;
+  place-items: center;
+  width: 44px;
+  height: 44px;
+  border-radius: 50%;
+  text-decoration: none;
+}
+
+.avatar > span {
+  display: grid;
+  place-items: center;
+  width: 36px;
+  height: 36px;
+  border-radius: 50%;
+  background: color-mix(in srgb, var(--accent) 14%, var(--surface));
+  color: var(--accent);
+  font-family: var(--font-display);
+  font-weight: 700;
+}
+
+/* Pastille de connexion : point de 7 px, texte secondaire en 13 px. */
+.pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-width: 0;
+  font-size: 0.8125rem;
+  color: var(--text-muted);
+  white-space: nowrap;
+}
+
+.pillDot {
+  flex: none;
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: var(--text-muted);
+}
+
+.pillDot[data-tone="online"] {
+  background: var(--success);
+}
+
+.pillDot[data-tone="warning"] {
+  background: var(--warning-text);
+}
+
+/* Bandeau de mise à jour sous l'en-tête, aux marges de la page ; rien quand il n'y a pas de version. */
+.bannerSlot {
+  width: 100%;
+  max-width: var(--content-width);
+  margin: 0 auto;
+  padding: 18px 18px 0;
+  padding-inline-start: max(18px, var(--page-inset-start));
+}
+
+.bannerSlot:empty {
+  display: none;
+}
+
+/*
+ * Barre d'onglets en pilule (68 px, rayon 24, 4 colonnes) posée au-dessus du contenu, sous les feuilles du bas
+ * (z-index 100). Fond de la carte presque opaque et flou derrière ; ombre portée des maquettes en clair.
+ */
+.tabBar {
+  position: fixed;
+  left: 14px;
+  right: 14px;
+  bottom: calc(16px + env(safe-area-inset-bottom, 0px));
+  z-index: 50;
+  max-width: 560px;
+  height: 68px;
+  margin: 0 auto;
+  padding: 7px;
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 4px;
+  border-radius: 24px;
+  border: 1px solid var(--border);
+  background: color-mix(in srgb, var(--surface) 92%, transparent);
+  box-shadow:
+    0 2px 6px rgb(16 21 31 / 0.08),
+    0 12px 30px rgb(16 21 31 / 0.1);
+  -webkit-backdrop-filter: blur(12px);
+  backdrop-filter: blur(12px);
+}
+
+/* Pastille de l'onglet actif : une colonne de large, elle glisse jusqu'à l'onglet n° --tab-index. */
+.tabPill {
+  position: absolute;
+  left: 7px;
+  top: 7px;
+  bottom: 7px;
+  width: calc((100% - 26px) / 4);
+  border-radius: 17px;
+  background: color-mix(in srgb, var(--accent) 12%, transparent);
+  transform: translateX(calc(var(--tab-index, 0) * (100% + 4px)));
+  transition: transform var(--dur-screen) var(--ease);
+}
+
+.tabPill[hidden] {
+  display: none;
+}
+
+.tab {
+  position: relative;
+  z-index: 1;
+  min-width: 0;
+  min-height: 44px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 2px;
+  border-radius: 17px;
+  color: var(--text-muted);
+  font-size: 0.75rem;
+  font-weight: 500;
+  line-height: 1.2;
+  text-decoration: none;
+  transition: color var(--dur-fast) var(--ease);
+}
+
+.tab[aria-current="page"] {
+  color: var(--accent);
+  font-weight: 600;
+}
+
+.tab:focus-visible {
+  outline-offset: -2px;
+}
+
+/* Navigation latérale (≥ 900 px) : marque en haut, entrées de 48 px, l'active teintée d'accent. */
+.sideNav {
+  position: sticky;
+  top: 0;
+  height: 100vh;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-6);
+  padding: var(--space-6) var(--space-4);
+  border-inline-end: 1px solid var(--border);
+  background: var(--surface);
+}
+
+.sideNav .brand {
+  padding-inline: 10px;
+}
+
+.sideList {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-1);
+}
+
+.sideItem {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  min-height: 48px;
+  padding: 0 14px;
+  border-radius: var(--radius-control);
+  color: var(--text-muted);
+  font-weight: 500;
+  text-decoration: none;
+  transition:
+    background-color var(--dur-fast) var(--ease),
+    color var(--dur-fast) var(--ease);
+}
+
+.sideItem[aria-current="page"] {
+  background: color-mix(in srgb, var(--accent) 12%, transparent);
+  color: var(--accent);
+  font-weight: 600;
+}
+
+@media (hover: hover) {
+  .sideItem:hover:not([aria-current="page"]) {
+    background: color-mix(in srgb, var(--accent) 6%, transparent);
+    color: var(--text);
+  }
+}
+
+/* PC : navigation latérale à gauche, contenu centré limité à 960 px, plus de place gardée en bas. */
+@media (min-width: 900px) {
+  .shell[data-wide] {
+    display: grid;
+    grid-template-columns: 240px minmax(0, 1fr);
+    padding-bottom: 0;
+  }
+
+  .shell[data-wide] .main,
+  .shell[data-wide] .header,
+  .shell[data-wide] .bannerSlot {
+    max-width: 960px;
+  }
+}
+
+/* Couleurs forcées (contraste élevé) : les teintes disparaissent, l'onglet actif garde un cadre. */
+@media (forced-colors: active) {
+  .tab[aria-current="page"],
+  .sideItem[aria-current="page"] {
+    outline: 2px solid LinkText;
+    outline-offset: -2px;
+  }
+}
+
+/*
+ * Démarrage : voile du fond du thème par-dessus tout, qui ne prend jamais le toucher. Le cadre du logo se
+ * dessine (900 ms), la rune et les repères apparaissent, puis le voile s'efface (fin à 1,45 s).
+ * Longueur du cadre brisé dans le viewBox 512 : 1 288 unités, d'où le tiret de 1 300.
+ */
+.splash {
+  position: fixed;
+  inset: 0;
+  z-index: 90;
+  display: grid;
+  place-items: center;
+  background: var(--bg);
+  pointer-events: none;
+  animation: splash-out 300ms var(--ease) 1150ms forwards;
+}
+
+.splashMark {
+  display: flex;
+  color: var(--text);
+  --rune-mark-frame: var(--accent);
+}
+
+.splashMark g > path:first-child {
+  stroke-dasharray: 1300;
+  animation: splash-draw 900ms var(--ease) 100ms backwards;
+}
+
+.splashMark g > path:nth-child(2) {
+  animation: splash-fade 300ms var(--ease) 700ms backwards;
+}
+
+.splashMark svg > path {
+  animation: splash-fade 400ms var(--ease) 650ms backwards;
+}
+
+@keyframes splash-draw {
+  from {
+    stroke-dashoffset: 1300;
+  }
+  to {
+    stroke-dashoffset: 0;
+  }
+}
+
+@keyframes splash-fade {
+  from {
+    opacity: 0;
+  }
+}
+
+@keyframes splash-out {
+  to {
+    opacity: 0;
+    visibility: hidden;
+  }
+}
+
+/* Mouvement réduit : la pastille change d'onglet sans glisser (le démarrage, lui, ne s'affiche pas). */
+@media (prefers-reduced-motion: reduce) {
+  .tabPill {
+    transition: none;
+  }
+}
