+    ]);
+    await seedMirror(db, 'place', [
+      { id: 'p-1', ownerId: 'u-1', kind: 'home', gymId: null, name: 'Maison', isPrimary: true },
+    ]);
+    await seedMirror(db, 'training_profile', [{ id: 'u-1', ownerId: 'u-1', goal: 'muscle' }]);
