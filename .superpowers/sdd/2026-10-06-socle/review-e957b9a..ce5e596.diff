+    await until(() => isChecked('Prendre du muscle'));
+    expect(progress()).toBe('Étape 1/8');
+    expect(t.server.patches).toHaveLength(1);
+  });
+
+  it("étape 'place' sans type de lieu connu → 'place_kind' (le choix n'est pas gardé)", async () => {
