+    },
+    checkForUpdate: async () => {},
+    applyUpdate: vi.fn(async () => {}),
+    markForced() {
+      this.set({ forced: true });
+    },
+    set(patch) {
+      state = { ...state, ...patch };
+      for (const fn of listeners) fn(state);
+    },
+  };
+}
+
+const banner = () => screen.queryByTestId('update-banner');
+const button = (name: string) => screen.queryByRole('button', { name });
+
+afterEach(() => {
