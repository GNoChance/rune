+
+  it('appli installée → une demande, résultat dans meta.persistGranted', async () => {
+    const { request, db } = await createAccount(true);
+    expect(request).toHaveBeenCalledTimes(1);
+    expect(typeof (await getMeta(db, 'persistGranted'))).toBe('boolean');
+  });
+
+  it('onglet de navigateur → aucune demande', async () => {
