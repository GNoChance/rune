+
+async function markLocalDb(db: AppDb, storage: CacheStorage | undefined): Promise<void> {
+  try {
+    await db.open();
+  } catch {
+    // Base illisible : elle ne décrit rien qu'un marqueur doive protéger.
+    return;
+  }
+  await raiseLocalDbMarker(storage);
