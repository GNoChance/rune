index 535acaf..7f2a070 100644
--- a/infra/host/test/defaults.bash
+++ b/infra/host/test/defaults.bash
@@ -129,3 +129,18 @@ default_restic() {
   # restic -r <dépôt> … : B2 seulement lit b2.env (sous-shell de restic_on).
   printf '%s %s\n' "${2:-}" "${AWS_ACCESS_KEY_ID:-none}" >>"$STATE/restic-env"
 }
+
+# Descripteur 9 hérité ouvert en écriture, et sous Linux sur $LOCK_FILE (take_lock : exec 9>"$LOCK_FILE").
+lock_fd_open() {
+  { : >&9; } 2>/dev/null || return 1
+  if [[ "$OSTYPE" == linux* ]]; then
+    [ "$(readlink "/proc/$$/fd/9")" = "$(readlink -f "$LOCK_FILE")" ] || return 1
+  fi
+}
+
+# flock -n 9 : comme le vrai flock, échoue si le descripteur 9 n'est pas ouvert sur le fichier verrou.
+default_flock() {
+  lock_fd_open && return 0
+  echo "flock: 9: Bad file descriptor" >&2
+  return 1
+}
