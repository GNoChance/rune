+
+describe('HealthSection › mode prudent (E7.5, R-CST-7)', () => {
+  it('CautiousModeToggle → PATCH /api/me/training-profile { cautiousMode: false }', async () => {
+    const t = await renderHealth({ cautiousMode: true });
