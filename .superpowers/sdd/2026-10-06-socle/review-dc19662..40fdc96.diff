+    expect(birth[usedLim1]).toBe('2010-01-01');
+  });
+
+  it('réinitialisations : bornes exactes', async () => {
+    ctx = await createTestContext();
+    const { db } = ctx.deps;
+    const u = await insertFixtureRow(db, 'user');
