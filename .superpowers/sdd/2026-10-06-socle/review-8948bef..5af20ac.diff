+  return createUserAndLogin(ctx);
+}
+
+const bumpRev = () =>
+  (
+    ctx.deps.sqlite
+      .prepare('UPDATE server_meta SET sync_counter = sync_counter + 1 RETURNING sync_counter')
+      .get() as { sync_counter: number }
+  ).sync_counter;
+
