+/* Écrans d'administration : membres, invitations, salles, état du serveur. */
+.nav ul {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2) var(--space-4);
+}
+
+.nav a {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+}
+
+.nav a[aria-current="page"] {
+  font-weight: 700;
+  color: var(--color-text);
+  text-decoration: none;
+}
+
+.section,
+.form,
+.dialogForm,
+.failure {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+}
+
+.section h2 {
+  margin: 0;
+  font-size: 1.25rem;
+}
+
+.section h3 {
+  margin: 0;
+  font-size: 1rem;
+}
+
+.section p,
+.dialogForm p,
+.secretPanel p {
+  margin: 0;
+}
+
+.form > button,
+.failure > button,
