+
+  it('health E1 puis 410 watermark_expired portant E2 → miroirs intacts, un seul cycle immédiat de plus', async () => {
+    server.epoch = 'E1';
+    let mirrorAtFullPull = -1;
+    server.on('GET /api/sync/pull', async (req) => {
