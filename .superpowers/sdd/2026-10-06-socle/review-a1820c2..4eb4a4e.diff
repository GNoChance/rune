+    await makeEngine().syncNow('manual');
+
+    expect(server.paths()).toEqual([
+      'GET /api/health',
+      'POST /api/sync/push',
+      'GET /api/sync/pull',
+      'GET /api/health',
+      'POST /api/sync/push',
