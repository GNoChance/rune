{
  "name": "rune",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "pnpm --filter @rune/server dev",
    "lint": "biome check .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @rune/web test:e2e",
    "test:infra": "env LC_ALL=C.UTF-8 bats infra/host/test",
    "build": "pnpm --filter @rune/web build && pnpm build:server",
    "build:server": "pnpm --filter @rune/server build",
    "data:validate": "node --import tsx scripts/data/validate.ts",
    "data:pull": "node --import tsx scripts/data/pull.ts",
    "exercises:draft": "node --import tsx scripts/exercises/draft.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@rune/contracts": "workspace:*",
    "@rune/domain": "workspace:*",
    "@types/node": "^24.7",
    "bats": "^1.13.0",
    "tsx": "4.23.15",
    "typescript": "^7",
    "vitest": "^5"
  }
}
