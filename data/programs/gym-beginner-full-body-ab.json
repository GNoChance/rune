          "progression": { "type": "double" }
        },
        {
          "id": "B5",
          "movementPattern": "horizontal_push",
          "role": "accessory",
          "exercises": ["dumbbell-bench-press", "machine-chest-press", "push-up"],
          "sets": [
            { "kind": "work", "count": 2, "reps": { "min": 8, "max": 12 }, "targetRir": 2, "restS": 90 }
          ],
          "progression": { "type": "double" }
        }
      ]
    }
  ]
