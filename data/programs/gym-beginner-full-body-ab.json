{
  "schemaVersion": 1,
  "id": "gym-beginner-full-body-ab",
  "version": 1,
  "name": "Salle · Débutant · Corps entier A/B",
  "description": "Deux séances corps entier qui alternent, 2 ou 3 fois par semaine. Les grands mouvements à la barre en 3 séries de 6 : la charge monte quand toutes les séries passent. Les compléments en 8 à 12 répétitions.",
  "context": "gym",
  "level": "beginner",
  "daysPerWeek": { "min": 2, "max": 3, "default": 3 },
  "estimatedMinutes": 55,
  "block": { "mode": "reactive" },
  "workouts": [
    {
      "id": "A",
      "name": "Séance A",
      "slots": [
        {
          "id": "A1",
          "movementPattern": "squat",
          "role": "main",
          "exercises": ["back-squat", "goblet-squat", "leg-press", "bodyweight-squat"],
          "sets": [
            { "kind": "warmup", "count": 2, "reps": { "min": 5, "max": 5 }, "pctWorkLoad": 50 },
            { "kind": "work", "count": 3, "reps": { "min": 6, "max": 6 }, "targetRir": 2, "restS": 150 }
          ],
          "progression": { "type": "linear", "incrementG": 5000 }
        },
        {
          "id": "A2",
          "movementPattern": "horizontal_push",
          "role": "main",
          "exercises": ["bench-press", "dumbbell-bench-press", "machine-chest-press", "push-up"],
          "sets": [
            { "kind": "warmup", "count": 2, "reps": { "min": 5, "max": 5 }, "pctWorkLoad": 50 },
            { "kind": "work", "count": 3, "reps": { "min": 6, "max": 6 }, "targetRir": 2, "restS": 150 }
          ],
          "progression": { "type": "linear", "incrementG": 2500 }
        },
        {
          "id": "A3",
          "movementPattern": "horizontal_pull",
          "role": "secondary",
          "exercises": ["seated-cable-row", "one-arm-dumbbell-row", "table-row"],
          "sets": [
            { "kind": "work", "count": 3, "reps": { "min": 8, "max": 12 }, "targetRir": 2, "restS": 120 }
          ],
          "progression": { "type": "double" }
        },
        {
          "id": "A4",
          "movementPattern": "knee_flexion",
          "role": "accessory",
          "exercises": ["leg-curl", "assisted-nordic-curl"],
          "sets": [
            { "kind": "work", "count": 2, "reps": { "min": 8, "max": 12 }, "targetRir": 2, "restS": 90 }
          ],
          "progression": { "type": "double" }
        },
        {
          "id": "A5",
          "movementPattern": "core_anti_extension",
          "role": "accessory",
          "chain": "front-plank",
          "sets": [
            { "kind": "work", "count": 3, "durationS": { "min": 20, "max": 60 }, "targetRir": 2, "restS": 60 }
          ],
          "progression": { "type": "duration", "stepS": 5 }
        }
      ]
    },
    {
      "id": "B",
      "name": "Séance B",
      "slots": [
        {
          "id": "B1",
          "movementPattern": "hip_hinge",
          "role": "main",
